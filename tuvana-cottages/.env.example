# Copy to .env.local for local development, and set the same values as
# environment variables in Vercel for production.
#
# The site runs without any of these — it falls back to demo content so the
# design can be reviewed and deployed before the database exists. Booking
# only becomes real once Supabase is connected.

# --- Supabase (Settings → API in the Supabase dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Secret. Bypasses row level security and is only ever read on the server.
# Never expose it to the browser and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner dashboard at /admin ---
ADMIN_PASSWORD=
# 32+ random chars: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Scheduled cleanup of expired holds ---
# Authorises POST /api/cron/expire-holds: openssl rand -hex 16
CRON_SECRET=
